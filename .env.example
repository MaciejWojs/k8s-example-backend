USE_VAULT=false

# Required when USE_VAULT=true (VAULT_SECRETS_MODE=api, default)
# VAULT_SECRETS_MODE=api
# VAULT_ADDR=http://vault.vault.svc.cluster.local:8200
# VAULT_ROLE=myapp
# VAULT_SECRET_PATH=secret/data/myapp/config

# Vault Agent Injector (file on disk instead of Vault API)
# VAULT_SECRETS_MODE=injector
# VAULT_SECRET_PATH=/vault/secrets/config

DATABASE_URL="postgresql://postgres:postgresPassword@localhost:5432/some_database"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgresPassword
POSTGRES_DB=some_database

PERFORM_DATABASE_MIGRATIONS=true
PERFORM_DATABASE_SEEDING=true